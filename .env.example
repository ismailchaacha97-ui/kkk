# Never commit a real key. This file is the template only.
# 1. Make a BRAND NEW wallet just for deploying. Not your main wallet.
# 2. Fund it with ~$3 of ETH on Base.
PRIVATE_KEY=

# Free public RPCs work fine. Override for better reliability if you want.
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Free key from https://basescan.org/myapikey — needed for source verification.
BASESCAN_API_KEY=

# Address that receives the full supply at deploy. Defaults to the deployer.
TREASURY_ADDRESS=

REPORT_GAS=false
